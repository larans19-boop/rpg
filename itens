def incluir(conn, nome, tipo, poder):
    """
    Insere um novo item.
    Retorna o id gerado.
    """
    cursor = conn.execute(
        "INSERT INTO itens (nome, tipo, poder) VALUES (?, ?, ?)", 
        (nome, tipo, poder)
    )
    conn.commit()
    return cursor.lastrowid


def buscar_por_id(conn, id):
    """
    Busca um item pelo id.
    Retorna uma tupla (id, nome, tipo, poder) ou None se não existir.
    """
    cursor = conn.execute(
        "SELECT id, nome, tipo, poder FROM itens WHERE id = ?", 
        (id,)
    )
    return cursor.fetchone()


def buscar_por_nome(conn, nome):
    """
    Busca itens que contêm a string 'nome' no nome do item.
    Retorna uma lista de tuplas (id, nome, tipo, poder).
    """
    cursor = conn.execute(
        "SELECT id, nome, tipo, poder FROM itens WHERE nome LIKE ? ORDER BY nome", 
        ("%" + nome + "%",)
    )
    return cursor.fetchall()


def listar(conn):
    """
    Lista todos os itens ordenados por id.
    Retorna uma lista de tuplas (id, nome, tipo, poder).
    """
    cursor = conn.execute("SELECT id, nome, tipo, poder FROM itens ORDER BY id")
    return cursor.fetchall()
