# Consulta base utilizando JOINs para trazer o apelido do jogador e o nome da classe
CONSULTA = """
SELECT personagens.id, personagens.nome, personagens.nivel, jogadores.apelido, classes.nome
FROM personagens
JOIN jogadores ON jogadores.id = personagens.jogador_id
JOIN classes ON classes.id = personagens.classe_id
"""


def incluir(conn, nome, nivel, jogador_id, classe_id):
    """
    Insere um novo personagem.
    Retorna o id gerado.
    """
    cursor = conn.execute(
        "INSERT INTO personagens (nome, nivel, jogador_id, classe_id) VALUES (?, ?, ?, ?)",
        (nome, nivel, jogador_id, classe_id)
    )
    conn.commit()
    return cursor.lastrowid


def buscar_por_id(conn, id):
    """
    Busca um personagem pelo seu id com dados legíveis do jogador e classe.
    Retorna uma tupla ou None.
    """
    cursor = conn.execute(
        CONSULTA + " WHERE personagens.id = ?", 
        (id,)
    )
    return cursor.fetchone()


def buscar_por_nome(conn, nome):
    """
    Busca personagens pelo nome do personagem.
    Retorna uma lista de tuplas.
    """
    cursor = conn.execute(
        CONSULTA + " WHERE personagens.nome LIKE ? ORDER BY personagens.nome", 
        ("%" + nome + "%",)
    )
    return cursor.fetchall()


def listar(conn):
    """
    Lista todos os personagens com apelido do jogador e nome da classe.
    """
    cursor = conn.execute(CONSULTA + " ORDER BY personagens.id")
    return cursor.fetchall()
